{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/journey/",
      "destination": "/journey",
      "permanent": true
    },
    {
      "source": "/lessons/",
      "destination": "/lessons",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/journey",
      "destination": "/journey.html"
    },
    {
      "source": "/journey/",
      "destination": "/journey.html"
    },
    {
      "source": "/lessons",
      "destination": "/lessons.html"
    },
    {
      "source": "/lessons/",
      "destination": "/lessons.html"
    }
  ]
}
